#include <stdio.h>

// Define the Student structure
struct Student {
    int rollNo;
    char name[50];
    float marks[3];
    float total;
    float percentage;
};

int main() {
    int n;

    printf("Enter the number of students: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        printf("Invalid number of students.\n");
        return 1;
    }

    // Declare an array of structures of size n
    struct Student students[n];

    // Input details for each student
    for (int i = 0; i < n; i++) {
        printf("\nEnter the roll number, name and marks of 3 subjects (Student %d):\n", i + 1);
        scanf("%d %49s %f %f %f",
              &students[i].rollNo,
              students[i].name,
              &students[i].marks[0],
              &students[i].marks[1],
              &students[i].marks[2]);

        // Calculate total and percentage (assuming each subject is out of 100)
        students[i].total = students[i].marks[0] + students[i].marks[1] + students[i].marks[2];
        students[i].percentage = (students[i].total / 300.0f) * 100.0f;
    }

    // Display formatted result table
    printf("\n%-8s %-15s %-11s %-11s %-11s %-8s %-10s\n",
           "Roll No", "Name", "Subject: 1", "Subject: 2", "Subject: 3", "Total", "Percentage");

    for (int i = 0; i < n; i++) {
        printf("%-8d %-15s %-11.0f %-11.0f %-11.0f %-8.0f %-10.2f\n",
               students[i].rollNo,
               students[i].name,
               students[i].marks[0],
               students[i].marks[1],
               students[i].marks[2],
               students[i].total,
               students[i].percentage);
    }

    return 0;
}
